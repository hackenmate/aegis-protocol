{
  "name": "aegis-protocol",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch backend/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch backend/index.ts",
    "build": "vite build",
    "start": "tsx backend/index.ts",
    "typecheck": "tsc --noEmit",
    "compile:guard": "solcjs --bin --abi contracts/AegisGuard.sol --output-dir .solc-out"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^4.22.2",
    "lucide-react": "^0.469.0",
    "openai": "^6.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.0",
    "solc": "^0.8.30",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
